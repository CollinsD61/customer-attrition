# =========================================================
# 1. SECRETS / ENVIRONMENT VARIABLES
# =========================================================

.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.pfx

secrets.yaml
secret.yaml
**/secrets.yaml
**/secrets-*.yaml
**/*secret*.yaml

aws_credentials
.aws/
credentials
config

# Không commit kubeconfig thật
kubeconfig
*.kubeconfig

# Terraform / cloud secret vars nếu có
*.tfvars
*.tfvars.json
!*.example.tfvars


# =========================================================
# 2. DATASETS / LARGE DATA FILES
# =========================================================

# Không commit raw, interim, processed data thật
data/raw/*
data/interim/*
data/processed/*
data/feature_tables/*

# Giữ cấu trúc thư mục
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/feature_tables/.gitkeep

# Cho phép commit sample data nhỏ
!data/samples/
!data/samples/**

# Dữ liệu lớn hoặc generated
*.csv
*.parquet
*.feather
*.arrow
*.orc
*.avro
*.h5
*.hdf5
*.npy
*.npz
*.joblib
*.pkl
*.pickle

# Nhưng cho phép fixture/sample nhỏ dùng trong test
!tests/fixtures/**
!**/tests/fixtures/**
!data/samples/**

# DVC quản lý file pointer, không ignore file .dvc
.dvc/cache/
.dvc/tmp/
.dvc/plots/
.dvc/repo/
.dvc/state
.dvc/state-journal


# =========================================================
